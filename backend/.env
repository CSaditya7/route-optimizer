# Copy this file to .env and fill in your values
# cp .env.example .env

# Server
PORT=3001
NODE_ENV=development

# CORS — set to your Vercel URL in production
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:5174

# OSRM public demo server (free, no key needed)
# For production, host your own: https://hub.docker.com/r/osrm/osrm-backend
OSRM_BASE_URL=https://router.project-osrm.org

# Request timeout for OSRM calls (milliseconds)
OSRM_TIMEOUT_MS=15000

# Maximum stops allowed per optimize request
MAX_STOPS=25

# Rate limiting — requests per window per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
